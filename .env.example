# NON-SECRET CONFIG ONLY - placeholder values, do not use production keys
APP_ENV=development
STELLAR_NETWORK=testnet
PORT=3001
# Future (not used yet): DATABASE_URL=postgresql://localhost:5432/unbound_dev
# Future (not used yet): REDIS_URL=redis://localhost:6379
# DEV only: SQLite file for durable storage (omit for in-memory)
# DATABASE_FILE=./data/dev.db
# DEV only: create the first admin at startup (pick your own; never commit real values)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# BOOTSTRAP_ADMIN_PASSWORD=
# DEV: talk to an unbound-stellar gateway service instead of the fake
# STELLAR_GATEWAY_URL=http://127.0.0.1:3002
# STELLAR_GATEWAY_TOKEN=
# Soroban redemption escrow (unbound-stellar ADR 0002). With the fake gateway this enables the
# in-memory FakeEscrow; with a real gateway the service also needs ESCROW_CONTRACT_ID.
# STELLAR_ESCROW_ENABLED=true
# ESCROW_WINDOW_HOURS=168      # merchant answer window, 1..720 (default 7 days)
# Browser clients on other origins (e.g. the unbound-site console). Exact origins, comma-separated.
# Unset = no CORS headers (same-origin only).
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Maintenance jobs (stuck-intent recovery, dispute escalation, escrow reconciliation) run in-process.
# JOBS_ENABLED=false
